<?xml version="1.0" encoding="utf-8"?>
<!--
  信息流专用的视频层。

  `app:surface_type` 必须走 layout 属性：`PlayerView` 在构造期读它，而
  `TypedArray` 只能从「编译过的 attrs」里拿到枚举值——用 theme/`applyStyle`
  合并进去读不到（实测静默退回 SurfaceView）。

  为什么信息流必须用 TextureView：`SurfaceView` 是独立图层，走
  `composition type=DEVICE`（HWC 叠加层）合成；标题 / 进度条 / 按钮走 GPU
  合成的 window buffer。两条更新路径独立，`ViewPager2` 滚动时视频层会落后
  若干帧——用户读到的就是「文字滑过去了、视频没跟着走」，以及「翻页时露出
  一段既不是当前页也不是下一页的画面」。`TextureView` 是普通 View，与文字
  同 buffer 合成，物理上不会错位。

  正式播放页仍用代码构造的 SurfaceView 版本（一屏只有一集，没有滚动容器）。
-->
<com.hgtv.star.phone.FixedFirstFramePlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view" />
