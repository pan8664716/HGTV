<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!--
      播放期间的 CPU 保活：`ExoPlayer.setWakeMode(C.WAKE_MODE_NETWORK)` 需要它。
      没有这一条时，暂停 / 后台几秒后盒子进入 Doze，回来要重走 DNS + TLS + 取地址，
      用户读到的是「暂停一下再回来就放不了了」。只持 PARTIAL_WAKE_LOCK（不亮屏），
      且只在「真的在播」期间持有（见 `PlaybackPower`）。
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!--
      外部存储读写：给 Phone / TV 共用的卸载恢复快照用——把设备身份、登录会话、
      收藏、历史、搜索、稍后看、隐藏项和全部用户配置写到公共目录，卸载重装后恢复。
      4.4–5.1 是安装期权限（装上就有）；6 及以上由公共启动页统一运行时授权。
      传统存储模式下（见下面的 requestLegacyExternalStorage）这一个权限就等于整个公共存储的
      读写权，因此**不设 maxSdkVersion**。
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <!--
      图标走自适应图标（mipmap-anydpi-v26）：背景层是纯白不透明（@color/ic_launcher_background），
      前景是扁平风格的 Apple 标志（果身 + 果叶两块纯色），因此 Android 8.0+ 与 API 26 以下的兜底位图
      在桌面上是同一块白底 + 同一颗果子，不再由启动器决定底色（透明背景时不同启动器会垫黑 / 深灰底板）。
      前景 @drawable/app_icon 已经把物件缩进安全区，圆形 / 圆角方形遮罩都切不到果叶尖。
    -->
    <!--
      requestLegacyExternalStorage：在 targetSdk 29 下退回**传统存储模式**，让
      `WRITE_EXTERNAL_STORAGE` 覆盖整个 `/sdcard`——会话镜像要写的 `/sdcard/.hgtv/`
      只有这样才写得进去，而它是唯一「卸载不删」的位置。30 起该属性被系统忽略。
    -->

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
      语音搜索走系统 RecognizerIntent，**不声明 RECORD_AUDIO**：录音由系统语音服务完成。
      这里的 <queries> 只为 targetSdk 30+ 之后的包可见性准备——届时 `queryIntentActivities`
      不加这一条会返回空表，预检会把有语音服务的设备误判成「没有」。
      当前 targetSdk 仍是 29，这一条在 29 上不生效，也不影响 4.4（更早的系统直接忽略）。
    -->
    <queries>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH"/></intent>
    </queries>

    <application
        android:name=".HgtvApplication" android:label="HGTV" android:theme="@style/AppTheme" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:banner="@drawable/tv_banner" android:allowBackup="false" android:enableOnBackInvokedCallback="false" android:usesCleartextTraffic="true" android:networkSecurityConfig="@xml/network_security_config" android:requestLegacyExternalStorage="true" android:supportsRtl="true">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update_provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths"/>
        </provider>
        <!--
          不要注册 androidx.media.session.MediaButtonReceiver：它只把媒体键转给本包的
          MEDIA_BUTTON / MediaBrowserService，本应用没有这类 Service，一旦被系统调用就会在
          onReceive 里抛 IllegalStateException，直接把进程带崩（1.1.4.1 的线上闪退）。
          前台收键走 Activity.onKeyDown（4.4–5.1）与 MediaSession callback（21+）。
        -->
        <!--
          启动路由：唯一带 LAUNCHER / LEANBACK_LAUNCHER 的组件。

          **不用 `Theme.NoDisplay`**（2026-11 现场：小明 Q1 Pro 投影仪上 1.3.0 点开毫无反应，
          1.2.9.1 正常——那一版没有这一层，直接起 TvMainActivity）。NoDisplay 的活动不建窗口，
          `startActivity` 之后立刻 `finish()`，部分国产 TV 固件会先把任务清掉、再丢掉刚起来的
          目标页，表现就是「点了没反应」。换成半透明主题后这一层**有窗口**，任务里始终有东西，
          转发不会落空；`noHistory` 也一并去掉——它本来就是为「不建窗口」服务的。

          电视桌面看到的是 application 的 icon / banner，与之前一致。
        -->
        <activity android:name=".LaunchActivity" android:exported="true" android:theme="@style/LaunchRouter" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <!-- 首页首次启动与设置页共用的设备类型选择器；透明窗口只承载 PhoneDialog / TvDialog。 -->
        <activity android:name=".DeviceFormActivity" android:exported="false" android:theme="@style/DeviceFormDialogTheme" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTop" />
        <!-- TV 端：横屏 + 遥控器焦点导航。 -->
        <activity android:name=".tv.TvMainActivity" android:exported="true" android:theme="@style/StartupContentTheme" android:screenOrientation="landscape" android:windowSoftInputMode="adjustResize" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTop" />
        <!-- 旧组件名保留为别名，避免已有显式 Intent / 外部快捷方式因类重命名失效。 -->
        <activity-alias android:name=".tv.MainActivity" android:targetActivity=".tv.TvMainActivity" android:exported="true" />
        <!-- 手机 / 平板端：触摸 + 跟随屏幕方向。 -->
        <activity android:name=".phone.PhoneMainActivity" android:exported="false" android:theme="@style/StartupContentTheme" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTop" />
        <!--
          播放页**不锁竖屏**：横版片源要点全屏按钮切到横屏（见 PhonePlayerActivity.toggleFullscreen）。
          声明 portrait 会把 setRequestedOrientation 顶回去，按钮点了没反应。
        -->
        <activity android:name=".phone.PhoneSearchActivity" android:exported="false" android:configChanges="keyboard|keyboardHidden|navigation|uiMode" android:windowSoftInputMode="adjustResize" android:launchMode="singleTop" />
        <activity android:name=".phone.PhoneDetailActivity" android:exported="false" android:configChanges="keyboard|keyboardHidden|navigation|uiMode" android:launchMode="singleTop" />
        <activity android:name=".phone.PhoneAccountActivity" android:exported="false" android:configChanges="keyboard|keyboardHidden|navigation|uiMode" android:launchMode="singleTop" />
        <activity android:name=".phone.PhoneSettingsActivity" android:exported="false" android:configChanges="keyboard|keyboardHidden|navigation|uiMode" android:launchMode="singleTop" />
        <!--
          正式播放页统一使用不透明窗口。推荐页与简介页都可能在下层保留独立 SurfaceView，
          半透明播放窗口会让它们从透明区域或 Surface 挖孔中露出来。
        -->
        <activity android:name=".phone.PhonePlayerActivity" android:exported="false" android:theme="@style/PlayerOpaqueTheme" android:screenOrientation="unspecified" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode" android:launchMode="singleTop" />
        <!--
          导航入口统一启动这个子类，Manifest 从窗口创建时就固定不透明主题。
        -->
        <activity android:name=".phone.PhonePlayerOpaqueActivity" android:exported="false" android:theme="@style/PlayerOpaqueTheme" android:screenOrientation="unspecified" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode" android:launchMode="singleTop" />
    </application>
</manifest>
