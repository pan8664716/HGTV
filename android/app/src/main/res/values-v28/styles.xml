<resources>
    <!--
      正式播放页统一使用不透明窗口。

      推荐页和简介页都可能在下层保留独立 SurfaceView；半透明播放窗口无法保证普通
      View 底板覆盖这些系统图层，会露出下层页面。播放器已经始终使用自己的 SurfaceView，
      不再需要靠半透明窗口保活下层视频。
    -->
    <style name="PlayerTheme" parent="@style/AppTheme">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- 导航入口显式使用这份主题，避免以后基础主题调整时重新引入透明窗口。 -->
    <style name="PlayerOpaqueTheme" parent="@style/PlayerTheme">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
