<resources>
    <!--
      系统主题：只负责「窗口还没建出来之前的那一帧」与系统控件（光标、选择手柄）的兜底配色。
      真正的色板在 TvTheme.kt（二十套主题），TvMainActivity.onCreate 会在建视图之前
      把窗口底色换成当前主题的底色，因此这里填的是**默认主题「深海蓝」**的色值：
      底色 #1E2228、抬升面 #2A3038、深凹槽 #12151A、焦点色 #4DA3FF。

      Android 4.4（API 19）上没有 Theme.Material（API 21 才有），父主题退回 Theme.Holo；
      21+ 的覆盖项放在 values-v21/styles.xml 里，因此两边看到的是同一套色值。
    -->
    <style name="AppTheme" parent="android:style/Theme.Holo.NoActionBar">
        <item name="android:windowBackground">#1E2228</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- 正式播放页始终使用不透明窗口，避免下层 Activity 的独立 SurfaceView 透出。 -->
    <style name="PlayerTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- 导航入口显式使用这份主题，避免以后基础主题调整时重新引入透明窗口。 -->
    <style name="PlayerOpaqueTheme" parent="@style/PlayerTheme">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!--
      启动页（`LaunchActivity`）：正常、不透明窗口。

      Logo 由系统启动画面显示，页面内只保留三点加载动画；本地初始化成功后才进入 TV / Phone。
      `Theme.NoDisplay` 会让部分国产固件提前清任务；透明窗口则不参与系统启动画面，
      初始化稍慢时用户看到的是桌面毫无变化。这里继承 AppTheme，从进程创建开始就有
      稳定底色，Android 12+ 也会复用 AppTheme 的 splash 图标配置。
    -->
    <style name="LaunchRouter" parent="@style/AppTheme">
        <item name="android:windowBackground">@drawable/startup_window</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!--
      首页与设置页共用的设备类型选择 Activity。

      必须继承 AppTheme：AlertDialog 会从宿主 Activity 主题解析 dialogTheme。直接继承
      Theme.Translucent.NoTitleBar 会让 21+ 的系统弹框回到 Holo，内部拟态面板之外的窗口
      尺寸、内边距和字体就和设置页对不上了。
    -->
    <style name="DeviceFormDialogTheme" parent="@style/AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- 主界面在首帧前先铺稳定底色；动态三点由轻量启动壳绘制，避免窗口预览图停住。 -->
    <style name="StartupContentTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@drawable/startup_window</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
